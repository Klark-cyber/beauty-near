# ─── SERVER PORTS ────────────────────────────────────────────────────────
PORT_API=3010
PORT_BATCH=3011

# ─── DATABASE (MongoDB Atlas) ────────────────────────────────────────────
# ⚠️ Deploy qilishda: MONGO_DEV va MONGO_PROD alohida, BOSHQA-BOSHQA
# bazalarga (yoki hatto alohida Atlas cluster'larga) ishora qilishi kerak —
# test va production ma'lumotlari hech qachon aralashmasligi uchun.
MONGO_DEV=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/BeautyNear_dev
MONGO_PROD=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/BeautyNear_prod

# ─── AUTH ─────────────────────────────────────────────────────────────────
# ⚠️ Production'ga chiqishdan oldin bu qiymatni albatta yangi, uzun,
# tasodifiy satr bilan almashtiring (masalan: `openssl rand -hex 32`)
SECRET_TOKEN=<your-own-random-secret-string>

# ─── TOSS PAYMENTS ────────────────────────────────────────────────────────
# ⚠️ Hozircha booking.service.ts ichida TEST kaliti qattiq yozilgan
# (test_sk_...). Haqiqiy to'lovlarni yoqish uchun buni environment
# variable'ga ko'chirib, TossPayments dashboard'idan olingan haqiqiy
# (live_sk_...) kalit bilan almashtirish kerak.
TOSS_SECRET_KEY=test_sk_your_test_key_here
